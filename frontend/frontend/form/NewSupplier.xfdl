                  <Layout>
                    <ImageViewer id="img00" taborder="0" left="0" top="0" width="81" height="81" border="1px dashed #9d9d9d" borderRadius="50%"/>
                    <Static id="sta00" taborder="1" text="Drag image here" left="101" top="9" width="110" height="20" font="normal 400 14px/20px &quot;Segoe UI&quot;" color="#858d9d" textAlign="center"/>
                    <Static id="sta01" taborder="2" text="or" left="149" top="30" width="14" height="20" font="normal 400 14px/20px &quot;Segoe UI&quot;" color="#858d9d" textAlign="center"/>
