<?xml version="1.0" encoding="utf-8"?>
<ADL version="2.0">
  <Application id="application" screenid="desktop" onload="application_onload">
    <Layout>
      <MainFrame id="mainframe" showtitlebar="true" showstatusbar="false" width="1920" height="945" titletext="Employee" showcascadetitletext="false" openalign="center middle" onsize="mainframe_onsize" background="#F0F1F3">
        <VFrameSet id="vfrs" showtitleicon="false" showtitlebar="false" showstatusbar="false" separatesize="*,0,0">
          <Frames>
            <ChildFrame id="frm_login" formurl="" dragmovetype="none" showtitlebar="false" showtitleicon="false"/>
            <ChildFrame id="frm_signup" formurl="" dragmovetype="none" showtitlebar="false" showtitleicon="false"/>
            <HFrameSet id="hfrs" showtitleicon="false" showtitlebar="false" showstatusbar="false" separatesize="373,*" background="#F0F1F3">
              <Frames>
                <ChildFrame id="frm_left" formurl="frame::LeftFrame.xfdl" dragmovetype="none" showtitlebar="false" showtitleicon="false"/>
                <VFrameSet id="vfrs_work" separatesize="100,*" showtitlebar="false" showtitleicon="false" background="#F0F1F3" left="10">
                  <Frames>
                    <ChildFrame id="frm_top" formurl="frame::TopFrame.xfdl" showtitlebar="false" dragmovetype="none" showtitleicon="false"/>
                    <ChildFrame id="frm_main" formurl="form::Dashboard.xfdl" showtitlebar="false" dragmovetype="none" showtitleicon="false"/>
                  </Frames>
                </VFrameSet>
              </Frames>
            </HFrameSet>
          </Frames>
        </VFrameSet>
      </MainFrame>
    </Layout>
  </Application>
  <Script type="xscript5.1"><![CDATA[// /**
// *  PcMdi 프로젝트
