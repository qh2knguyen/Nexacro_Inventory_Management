        <Div id="div_products" taborder="1" left="43" top="204" bottom="8" borderRadius="8px" background="#ffffff" right="43">
          <Layouts>
            <Layout>
              <Static id="sta_employees" taborder="0" text="Products" left="21" top="28" width="120" height="30" font="normal 500 20px/30px &quot;Segoe UI&quot;"/>
              <Button id="btn_add_product" taborder="1" text="Add Product" top="19" width="118" height="40" color="#ffffff" font="normal 500 14px/20px &quot;Segoe UI&quot;" background="#1366D9" borderRadius="4px" right="283"/>
              <Grid id="grd_products" taborder="2" left="21" top="68" right="21" autofittype="col" border="0px none" nodatatext="No data found" selecttype="row" binddataset="ds_inventory" onheadclick="div_employees_grd_employees_onheadclick" oncelldblclick="div_employees_grd_employees_oncelldblclick" oncellclick="div_employees_grd_employees_oncellclick" bottom="68">
                <Formats>
                  <Format id="default">
                    <Columns>
                      <Column size="48" band="left"/>
                      <Column size="138"/>
                      <Column size="111"/>
                      <Column size="80"/>
                      <Column size="80"/>
                      <Column size="80"/>
                      <Column size="108"/>
                    </Columns>
                    <Rows>
                      <Row size="46" band="head"/>
                      <Row size="46"/>
                    </Rows>
                    <Band id="head">
                      <Cell displaytype="normal" edittype="none" background="#ffffff" border="0px none, 0px none, 1px solid #d0d3d9"/>
                      <Cell col="1" text="Products" background="#ffffff" border="0px none, 0px none, 1px solid #d0d3d9" color="#667085" font="normal 500 14px/20px &quot;Segoe UI&quot;" textAlign="left"/>
                      <Cell col="2" text="Buying Price" background="#ffffff" border="0px none, 0px none, 1px solid #d0d3d9" color="#667085" font="normal 500 14px/20px &quot;Segoe UI&quot;" textAlign="left"/>
                      <Cell col="3" text="Quantity" background="#ffffff" border="0px none, 0px none, 1px solid #d0d3d9" color="#667085" font="normal 500 14px/20px &quot;Segoe UI&quot;" textAlign="left"/>
                      <Cell col="4" text="Threshold Value" background="#ffffff" border="0px none, 0px none, 1px solid #d0d3d9" color="#667085" font="normal 500 14px/20px &quot;Segoe UI&quot;" textAlign="left"/>
                      <Cell col="5" text="Expiry Date" background="#ffffff" border="0px none, 0px none, 1px solid #d0d3d9" color="#667085" font="normal 500 14px/20px &quot;Segoe UI&quot;" textAlign="left"/>
                      <Cell col="6" text="Availability" background="#ffffff" border="0px none, 0px none, 1px solid #d0d3d9" color="#667085" font="normal 500 14px/20px &quot;Segoe UI&quot;" textAlign="left"/>
                    </Band>
                    <Band id="body">
                      <Cell displaytype="checkboxcontrol" edittype="checkbox" text="bind:chkCol" border="0px none,0px none,1px solid #D0D3D9"/>
                      <Cell col="1" text="bind:name" border="0px none,0px none,1px solid #D0D3D9" color="#48505e" font="normal 500 14px/20px &quot;Segoe UI&quot;"/>
                      <Cell col="2" text="bind:buyingPrice" border="0px none,0px none,1px solid #D0D3D9" color="#48505e" font="normal 500 14px/20px &quot;Segoe UI&quot;"/>
                      <Cell col="3" text="bind:quantity" border="0px none,0px none,1px solid #D0D3D9" color="#48505e" font="normal 500 14px/20px &quot;Segoe UI&quot;"/>
                      <Cell col="4" text="bind:thresholdValue" border="0px none,0px none,1px solid #D0D3D9" color="#48505e" font="normal 500 14px/20px &quot;Segoe UI&quot;"/>
                      <Cell col="5" text="bind:expiryDate" border="0px none,0px none,1px solid #D0D3D9" color="#48505e" font="normal 500 14px/20px &quot;Segoe UI&quot;"/>
                      <Cell col="6" border="0px none,0px none,1px solid #D0D3D9" color="#48505e" font="normal 500 14px/20px &quot;Segoe UI&quot;" text="bind:availability"/>
                    </Band>
                  </Format>
                </Formats>
              </Grid>
              <Button id="btn_previous" taborder="3" text="Previous" width="101" height="40" borderRadius="4px" font="normal 500 14px/20px &quot;Segoe UI&quot;" color="#5d6679" left="21" bottom="12" onclick="div_employees_btn_previous_onclick"/>
              <Button id="btn_next" taborder="4" text="Next" width="101" height="40" borderRadius="4px" font="normal 500 14px/20px &quot;Segoe UI&quot;" color="#5d6679" right="21" bottom="12" onclick="div_employees_btn_next_onclick"/>
              <Static id="sta_pageText" taborder="5" text="Page 0 of 0" left="734" width="78" height="40" font="normal 400 14px/20px &quot;Segoe UI&quot;" bottom="12"/>
              <Button id="btn_download_all_products" taborder="6" text="Download all" top="19" width="118" height="40" right="21" borderRadius="4px" font="normal 500 14px/20px &quot;Segoe UI&quot;" color="#5d6679"/>
              <Button id="btn_filter_product" taborder="7" text="Filters" top="19" width="102" height="40" right="160" borderRadius="4px" font="normal 500 14px/20px &quot;Segoe UI&quot;" color="#5d6679"/>
            </Layout>
          </Layouts>
        </Div>
      </Layout>
    </Layouts>
    <Objects>
      <Dataset id="ds_employees">
        <ColumnInfo>
          <Column id="empId" type="STRING" size="256"/>
          <Column id="empName" type="STRING" size="256"/>
          <Column id="typeCd" type="STRING" size="256"/>
          <Column id="posCd" type="STRING" size="256"/>
          <Column id="empRank" type="STRING" size="256"/>
          <Column id="empCoeSalary" type="STRING" size="256"/>
          <Column id="degCd" type="STRING" size="256"/>
          <Column id="empCoeLimit" type="STRING" size="256"/>
          <Column id="empCoePos" type="STRING" size="256"/>
          <Column id="empCoeRes" type="STRING" size="256"/>
          <Column id="empAllCoe" type="STRING" size="256"/>
          <Column id="empNextPro" type="STRING" size="256"/>
          <Column id="noDecision" type="STRING" size="256"/>
          <Column id="status" type="STRING" size="256"/>
          <Column id="dateDecision" type="STRING" size="256"/>
          <Column id="totalCount" type="STRING" size="256"/>
          <Column id="chkCol" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_status">
        <ColumnInfo>
          <Column id="ID" type="STRING" size="256"/>
          <Column id="VALUE" type="STRING" size="256"/>
        </ColumnInfo>
        <Rows>
          <Row>
            <Col id="ID">ALL</Col>
            <Col id="VALUE">All</Col>
          </Row>
          <Row>
            <Col id="ID">ACTIVE</Col>
            <Col id="VALUE">Active</Col>
          </Row>
          <Row>
            <Col id="ID">INACTIVE</Col>
            <Col id="VALUE">Inactive</Col>
          </Row>
          <Row>
            <Col id="ID">PENDING</Col>
            <Col id="VALUE">Pending</Col>
          </Row>
        </Rows>
      </Dataset>
      <Dataset id="ds_emp_search">
        <ColumnInfo>
          <Column id="empName" type="STRING" size="256"/>
          <Column id="empCoeSalaryMin" type="STRING" size="256"/>
          <Column id="empCoeSalaryMax" type="STRING" size="256"/>
          <Column id="dateDecisionMin" type="STRING" size="256"/>
          <Column id="dateDecisionMax" type="STRING" size="256"/>
          <Column id="empRankMin" type="STRING" size="256"/>
          <Column id="empRankMax" type="STRING" size="256"/>
          <Column id="empAllCoeMin" type="STRING" size="256"/>
          <Column id="empAllCoeMax" type="STRING" size="256"/>
          <Column id="status" type="STRING" size="256"/>
        </ColumnInfo>
        <Rows>
          <Row>
            <Col id="status">ALL</Col>
          </Row>
        </Rows>
      </Dataset>
      <Dataset id="ds_del">
        <ColumnInfo>
          <Column id="empId" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_inventory">
        <ColumnInfo>
          <Column id="id" type="STRING" size="256"/>
          <Column id="productCode" type="STRING" size="256"/>
          <Column id="name" type="STRING" size="256"/>
          <Column id="unit" type="STRING" size="256"/>
          <Column id="quantity" type="STRING" size="256"/>
          <Column id="buyingPrice" type="STRING" size="256"/>
          <Column id="thresholdValue" type="STRING" size="256"/>
          <Column id="expiryDate" type="STRING" size="256"/>
          <Column id="availability" type="STRING" size="256"/>
          <Column id="chkCol" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
    </Objects>
